---
// Image component that renders <picture> with AVIF + WebP sources for
// any image under /uploads/. Variants are generated by
// scripts/optimise-images.mjs at build/commit time and committed to
// public/variants/.
//
// For images that don't have variants (SVGs, brand assets, missing
// files), this falls back to a plain <img> with the original src.
//
// Includes intrinsic width/height from the manifest so browsers can
// reserve space and avoid layout shift.
//
// Image records (src/content/images, see docs/images.md) supply alt text
// when the caller passes an empty one, and with `caption` the image is
// wrapped in a <figure> showing the record's caption, date and credit.

import manifest from '../../public/variants/manifest.json';
import { getImageRecord } from '../lib/images';
import { captionLine } from '../lib/caption-line';

type Manifest = Record<string, { width: number; height: number } | undefined>;
const m = manifest as Manifest;

interface Props {
  src: string;
  /** Omit to use the image record's alt text; pass "" for a decorative image. */
  alt?: string;
  /** Show the record's caption / date / credit underneath. */
  caption?: boolean;
  class?: string;
  sizes?: string;
  loading?: 'lazy' | 'eager';
  fetchpriority?: 'high' | 'low' | 'auto';
  /** Override intrinsic dimensions (else read from manifest). */
  width?: number;
  height?: number;
}

const {
  src,
  alt: altProp,
  caption = false,
  class: className,
  sizes = '(max-width: 768px) 100vw, 1280px',
  loading = 'lazy',
  fetchpriority,
  width,
  height,
} = Astro.props;

const match = src.match(/^\/uploads\/([^/]+)\.(jpe?g|png)$/i);
const stem = match ? match[1] : null;
const sourceFile = match ? `${match[1]}.${match[2]}` : null;
const meta = sourceFile ? m[sourceFile] : undefined;

const finalWidth = width ?? meta?.width;
const finalHeight = height ?? meta?.height;
const hasVariants = stem !== null;

const record = await getImageRecord(src);
const alt = altProp ?? (record?.data.alt ? String(record.data.alt) : '');
const line = caption && record ? captionLine(record.data) : null;
const Wrapper = line ? 'figure' : Fragment;
const wrapperProps = line ? { class: 'image-figure' } : {};

// Percent-encode the filename for use in URLs. Spaces and commas in an
// uploaded filename are invalid inside srcset (comma separates
// candidates, space separates a URL from its width descriptor) and
// silently break the whole <picture> element.
const encStem = stem ? encodeURIComponent(stem) : null;
const encSrc = sourceFile ? `/uploads/${encodeURIComponent(sourceFile)}` : src;

const avifSrcset = encStem
  ? `/variants/${encStem}-640.avif 640w, /variants/${encStem}-1280.avif 1280w`
  : '';
const webpSrcset = encStem
  ? `/variants/${encStem}-640.webp 640w, /variants/${encStem}-1280.webp 1280w`
  : '';
---
<Wrapper {...wrapperProps}>
  {hasVariants ? (
    <picture>
      <source type="image/avif" srcset={avifSrcset} sizes={sizes} />
      <source type="image/webp" srcset={webpSrcset} sizes={sizes} />
      <img
        src={encSrc}
        alt={alt}
        class={className}
        loading={loading}
        decoding="async"
        fetchpriority={fetchpriority}
        width={finalWidth}
        height={finalHeight}
      />
    </picture>
  ) : (
    <img
      src={encSrc}
      alt={alt}
      class={className}
      loading={loading}
      decoding="async"
      fetchpriority={fetchpriority}
      width={finalWidth}
      height={finalHeight}
    />
  )}
  {line && record && (
    <figcaption class="image-caption">
      {line.caption && <span class="image-caption__text">{line.caption}</span>}
      {line.meta && <span class="image-caption__meta">{line.meta}</span>}
      <a class="image-caption__link" href={`/images/${record.id}`}>Image details</a>
    </figcaption>
  )}
</Wrapper>
