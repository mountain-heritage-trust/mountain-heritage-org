---
import Banner from '../components/Banner.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import DonateBanner from '../components/DonateBanner.astro';
import { organizationSchema, safeJsonLd } from '../lib/schema';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogType?: 'website' | 'article';
  ogImage?: string;
  /** Page-specific Schema.org JSON-LD objects (Article, Person, etc.). */
  schemas?: unknown[];
  /** Article-specific Open Graph metadata for blog posts. */
  article?: {
    publishedTime?: string;
    author?: string;
    section?: string;
    tags?: string[];
  };
  /** Ask search engines not to index this page. */
  noindex?: boolean;
}

const {
  title,
  description,
  ogType = 'website',
  ogImage,
  schemas = [],
  article,
  noindex = false,
} = Astro.props;

const siteName = 'Mountain Heritage Trust';
const fullTitle = title === siteName ? title : `${title} | ${siteName}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const absoluteOgImage = ogImage ? new URL(ogImage, Astro.site).toString() : undefined;

const allSchemas = [organizationSchema(Astro.site as URL), ...schemas];

// Show the site-wide donate CTA everywhere except the donate page itself.
const path = Astro.url.pathname.replace(/\/+$/, '') || '/';
const showDonateBanner = path !== '/donate';

// Cloudflare Web Analytics (cookieless, no consent banner needed). The token
// is public and only set by the production build, so staging and local dev
// don't record visits. See docs/analytics.md.
const analyticsToken = import.meta.env.PUBLIC_CF_WEB_ANALYTICS_TOKEN;
---
<!doctype html>
<html lang="en-GB">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    {description && <meta name="description" content={description} />}
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={canonical} />

    <meta property="og:site_name" content={siteName} />
    <meta property="og:locale" content="en_GB" />
    <meta property="og:title" content={fullTitle} />
    {description && <meta property="og:description" content={description} />}
    <meta property="og:type" content={ogType} />
    <meta property="og:url" content={canonical} />
    {absoluteOgImage && <meta property="og:image" content={absoluteOgImage} />}

    {article?.publishedTime && (
      <meta property="article:published_time" content={article.publishedTime} />
    )}
    {article?.author && (
      <meta property="article:author" content={article.author} />
    )}
    {article?.section && (
      <meta property="article:section" content={article.section} />
    )}
    {article?.tags?.map((t) => (
      <meta property="article:tag" content={t} />
    ))}

    <meta name="twitter:card" content={absoluteOgImage ? 'summary_large_image' : 'summary'} />
    <meta name="twitter:title" content={fullTitle} />
    {description && <meta name="twitter:description" content={description} />}
    {absoluteOgImage && <meta name="twitter:image" content={absoluteOgImage} />}

    {allSchemas.map((s) => (
      <script type="application/ld+json" set:html={safeJsonLd(s)} />
    ))}

    <link rel="sitemap" type="application/xml" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${siteName} — News`} href="/rss.xml" />
    <link rel="icon" type="image/png" sizes="any" href="/brand/favicon.png" />
    <link rel="apple-touch-icon" href="/brand/favicon.png" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;600;700&display=swap"
    />

    {analyticsToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={JSON.stringify({ token: analyticsToken })}
      ></script>
    )}
  </head>
  <body>
    <a href="#main" class="skip-link">Skip to main content</a>
    <Banner />
    <Header />
    <main id="main">
      <slot />
    </main>
    {showDonateBanner && <DonateBanner />}
    <Footer />
  </body>
</html>
